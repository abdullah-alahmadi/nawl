          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Two built projects in comparable climates were analysed; "
          },
          {
            "type": "ref",
            "attrs": {
              "target": "tab-cases"
            }
          },
          {
            "type": "text",
            "text": " compares them."
          }
        ]
