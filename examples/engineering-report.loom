  "metadata": {
    "title": "A Climate-Responsive Community Centre in Al-Majmaah",
    "university": "Example University",
    "college": "College of Engineering",
    "department": "Department of Architecture",
    "course": "ARC 499 – Senior Design 1",
    "semester": "Fall Semester 2025/2026 (1447–1448 H)",
    "students": [
