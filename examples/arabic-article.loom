                        "content": [
                          {
                            "type": "text",
                            "text": "٢٩٫٠"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "tableCell",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "٣٨٫٠٪"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "figure",
        "attrs": {
          "src": "figures/irrigation-water.png",
          "widthPercent": 85,
          "id": "fig-water"
        },
        "content": [
          {
            "type": "caption",
            "content": [
              {
                "type": "text",
                "text": "استهلاك المياه الأسبوعي في قطعة المؤقت الزمني وقطعة النظام المقترح"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "وقد بلغ متوسط التوفير نحو ٣٧٪، وكان الفرق في وزن المحصول بين القطعتين أقل من ٣٪، وهو فرق غير دال إحصائيًا "
          },
          {
            "type": "inlineMath",
            "attrs": {
              "latex": "p > 0.05"
            }
          },
          {
            "type": "text",
            "text": ". ولم تتوقف أي عقدة عن العمل خلال مدة التجربة رغم ارتفاع درجات الحرارة نهارًا إلى ٤٤ درجة مئوية."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "sec-discussion",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "المناقشة"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "يرجع معظم التوفير إلى إلغاء الريات غير الضرورية في الأيام المعتدلة، وإلى تقليل مدة الري في الصباح الباكر حين تكون رطوبة التربة مرتفعة أصلًا. ويتفق ذلك مع ما توصلت إليه دراسات سابقة من أن الري المبني على قياس الرطوبة يقلل الهدر أكثر من أي جدولة زمنية مهما أُحكمت "
          },
          {
            "type": "citation",
            "attrs": {
              "keys": [
                "goap2018"
              ]
            }
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "In short, the controller watered only when the soil needed it, and the farm used about a third less water without losing yield."
          }
        ],
        "attrs": {
          "dir": "ltr"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "ومن حدود الدراسة قصر مدة التجربة واقتصارها على مزرعة واحدة في فصل الصيف، ولذلك يحتاج تعميم النتائج إلى تجارب أطول تشمل فصولًا ومحاصيل مختلفة."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "sec-conclusion",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "الخاتمة"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "قدّمت هذه الدراسة نظام ري ذكيًا منخفض التكلفة للمزارع الصغيرة، وأثبتت التجربة الميدانية قدرته على خفض استهلاك المياه بنحو الثلث دون التأثير في الإنتاج. وتوصي الدراسة بتجربة النظام على نطاق أوسع، وبدراسة ربطه بتوقعات الطقس لتأجيل الري قبل الأمطار."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": null,
          "numbered": false
        },
        "content": [
          {
            "type": "text",
            "text": "شكر وتقدير"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "يشكر الباحثان المزارع الذي أتاح موقع التجربة، وعمادة البحث العلمي بجامعة القصيم على دعمها."
          }
        ]
      }
    ]
  }
}
