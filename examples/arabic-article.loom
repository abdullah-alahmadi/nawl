            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "تهدف هذه الدراسة إلى قياس أثر التغذية الراجعة الفورية على تحصيل الطلاب، كما يوضح "
          },
          {
            "type": "ref",
