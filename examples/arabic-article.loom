            "type": "text",
            "text": "المقدمة"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "شهد التعليم الإلكتروني نموًا متسارعًا في العقد الأخير، وأصبحت تقنيات "
          },
          {
            "type": "text",
            "text": "machine learning",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": " جزءًا أساسيًا من أنظمة إدارة التعلم مثل "
          },
          {
            "type": "text",
            "text": "Moodle"
          },
          {
            "type": "text",
            "text": " و"
          },
          {
            "type": "text",
            "text": "Blackboard"
          },
          {
            "type": "text",
            "text": " "
          },
