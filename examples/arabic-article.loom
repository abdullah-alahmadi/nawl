                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "الرابع"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "tableCell",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
