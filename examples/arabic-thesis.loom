      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-preprocessing",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "المعالجة المسبقة"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "طُبّقت على التغريدات خطوات التطبيع الآتية قبل التدريب:"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "حذف الروابط وأسماء المستخدمين وعلامات المرور الزائدة."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "توحيد أشكال الألف والياء والتاء المربوطة، وحذف التشكيل والتطويل."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "تقليص الحروف المكررة، مثل «جمييييل» إلى «جميل»."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "الإبقاء على الرموز التعبيرية لأنها تحمل دلالة عاطفية مهمة."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-finetuning",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "ضبط النموذج"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "أُضيفت فوق نموذج AraBERT طبقة تصنيف تحسب احتمال كل فئة بدالة softmax، ودُرّب النموذج بتقليل دالة الإنتروبيا المتقاطعة في "
          },
          {
            "type": "ref",
            "attrs": {
              "target": "eq-loss"
            }
          },
          {
            "type": "text",
            "text": ":"
          }
        ]
      },
      {
        "type": "equation",
        "attrs": {
          "latex": "\\mathcal{L} = -\\frac{1}{N} \\sum_{i=1}^{N} \\sum_{c=1}^{3} y_{i,c} \\log \\hat{y}_{i,c}",
          "numbered": true,
          "id": "eq-loss"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "وقيس الأداء بمقياس F1 لكل فئة، وهو المتوسط التوافقي للدقة والاستدعاء كما في "
          },
          {
            "type": "ref",
            "attrs": {
              "target": "eq-f1"
            }
          },
          {
            "type": "text",
            "text": ":"
          }
        ]
      },
      {
        "type": "equation",
        "attrs": {
          "latex": "F_1 = \\frac{2 \\cdot P \\cdot R}{P + R}",
          "numbered": true,
          "id": "eq-f1"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "ch-results",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "النتائج ومناقشتها"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
