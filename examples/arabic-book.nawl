      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-arithmetic",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "العمليات الحسابية"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "تدعم بايثون العمليات الحسابية المعروفة، إضافة إلى القسمة الصحيحة وباقي القسمة والأس، كما في "
          },
          {
            "type": "ref",
            "attrs": {
              "target": "tab-operators"
            }
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "tableFigure",
        "attrs": {
          "id": "tab-operators"
        },
        "content": [
          {
            "type": "caption",
            "content": [
              {
                "type": "text",
                "text": "العمليات الحسابية في بايثون"
              }
            ]
          },
          {
            "type": "table",
            "content": [
              {
                "type": "tableRow",
                "content": [
                  {
                    "type": "tableHeader",
                    "attrs": {
                      "colspan": 1,
                      "rowspan": 1,
                      "colwidth": null
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
