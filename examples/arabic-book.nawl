      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-savings",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "مثال تطبيقي: الادخار الشهري"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "إذا ادّخر شخص مبلغًا "
          },
          {
            "type": "inlineMath",
            "attrs": {
              "latex": "P"
            }
          },
          {
            "type": "text",
            "text": " بربح مركب نسبته السنوية "
          },
          {
            "type": "inlineMath",
            "attrs": {
              "latex": "r"
            }
          },
          {
            "type": "text",
            "text": " مدة "
          },
          {
            "type": "inlineMath",
            "attrs": {
              "latex": "n"
            }
          },
          {
            "type": "text",
            "text": " سنة، فإن رصيده يصبح كما في "
          },
          {
            "type": "ref",
            "attrs": {
              "target": "eq-compound"
            }
          },
          {
            "type": "text",
            "text": ":"
          }
        ]
      },
      {
        "type": "equation",
        "attrs": {
          "latex": "A = P \\left(1 + \\frac{r}{100}\\right)^{n}",
          "numbered": true,
          "id": "eq-compound"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "ويمكن حساب ذلك ببضعة أسطر:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": null
        },
        "content": [
          {
            "type": "text",
            "text": "principal = 10000      # المبلغ بالريال\nrate = 5               # النسبة السنوية\nyears = 3\n\namount = principal * (1 + rate / 100) ** years\nprint(\"الرصيد بعد\", years, \"سنوات:\", round(amount, 2), \"ريال\")"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "ch-control",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "الجمل الشرطية والتكرار"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "لا تسير البرامج عادةً في خط مستقيم، بل تتخذ قرارات وتكرر خطوات. وفي هذا الفصل نتعرف على الجملة الشرطية "
          },
          {
            "type": "text",
            "text": "if",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": " وحلقتي "
          },
          {
            "type": "text",
            "text": "for",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": " و"
          },
          {
            "type": "text",
            "text": "while",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "citation",
            "attrs": {
              "keys": [
                "lutz2013"
              ]
            }
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-if",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "الجملة الشرطية"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "تنفّذ الجملة الشرطية جزءًا من البرنامج إذا تحقق شرط معين. لاحظ أن بايثون تعتمد على المسافة البادئة لتحديد الأسطر التابعة للشرط:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": null
        },
        "content": [
          {
            "type": "text",
            "text": "grade = int(input(\"أدخل الدرجة: \"))\n\nif grade >= 90:\n    print(\"ممتاز\")\nelif grade >= 75:\n    print(\"جيد جدًا\")\nelse:\n    print(\"واصل الاجتهاد\")"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-for",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "حلقة التكرار"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "تكرر حلقة "
          },
          {
            "type": "text",
            "text": "for",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": " مجموعة من التعليمات لكل عنصر في سلسلة. فالبرنامج الآتي يطبع جدول الضرب للعدد ٧:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": null
        },
        "content": [
          {
            "type": "text",
            "text": "for i in range(1, 11):\n    print(7, \"×\", i, \"=\", 7 * i)"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "sec-exercises",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "تمارين"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "اكتب برنامجًا يطلب من المستخدم درجة الحرارة بالمئوية ويحوّلها إلى فهرنهايت."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "اكتب برنامجًا يطبع الأعداد الزوجية من ٢ إلى ٥٠."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "عدّل برنامج الدرجات بحيث:"
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "يرفض الدرجات السالبة أو الأكبر من ١٠٠."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "يكرر السؤال حتى يُدخل المستخدم درجة صحيحة."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "appendixStart"
      },
