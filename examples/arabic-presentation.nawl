        "type": "slide",
        "attrs": {
          "id": null,
          "plain": false
        },
        "content": [
          {
            "type": "slideTitle",
            "content": [
              {
                "type": "text",
                "text": "استهلاك المياه خلال أربعة أسابيع"
              }
            ]
          },
          {
            "type": "figure",
            "attrs": {
              "src": "figures/irrigation-water.png",
              "widthPercent": 80,
              "id": "fig-water"
            },
            "content": [
              {
                "type": "caption",
                "content": [
                  {
                    "type": "text",
                    "text": "م³ لكل دونم أسبوعيًا"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "slide",
        "attrs": {
          "id": null,
          "plain": false
        },
        "content": [
          {
            "type": "slideTitle",
            "content": [
              {
                "type": "text",
                "text": "أبرز النتائج"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "توفير في المياه بنحو "
                      },
                      {
                        "type": "text",
                        "text": "٣٧٪",
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "text": " مقارنة بالمؤقت"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "فرق في المحصول أقل من ٣٪ (غير دال إحصائيًا)"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "لم تتوقف أي عقدة رغم حرارة ٤٤ درجة"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "slideBox",
            "attrs": {
              "kind": "example",
              "title": "مقارنة بالدراسات السابقة"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "نتائج قريبة من الأنظمة التجارية بتكلفة أقل بكثير "
                  },
                  {
                    "type": "citation",
                    "attrs": {
                      "keys": [
                        "goap2018"
                      ]
                    }
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          }
        ]
      },
