      },
      {
        "name": "سارة القحطاني",
        "affiliations": [
          "قسم الهندسة الكهربائية، كلية الهندسة، جامعة الأفق، بريدة"
        ]
      }
    ],
    "institute": "جامعة الأفق",
    "date": "جمادى الأولى ١٤٤٧هـ"
  },
  "bibliography": "@article{alahmadi2021,\n  author = {الأحمدي, عبدالله and الحربي, فيصل},\n  title = {كفاءة استخدام المياه في المزارع الصغيرة بمنطقة القصيم},\n  journal = {المجلة السعودية للعلوم الزراعية},\n  volume = {18},\n  number = {2},\n  pages = {33--52},\n  year = {2021}\n}\n\n@book{aldosari2019,\n  author = {الدوسري, منى},\n  title = {أساسيات الري بالتنقيط وتصميم شبكاته},\n  publisher = {دار النشر العلمي},\n  address = {الرياض},\n  year = {2019}\n}\n\n@inproceedings{alsubaie2022,\n  author = {السبيعي, خالد and العنزي, نوف and الشهري, ريم},\n  title = {الاستشعار اللاسلكي لرطوبة التربة في البيئات الصحراوية},\n  booktitle = {وقائع المؤتمر السعودي للهندسة الزراعية},\n  pages = {88--97},\n  year = {2022}\n}\n\n@book{allen1998,\n  author = {Allen, Richard G. and Pereira, Luis S. and Raes, Dirk and Smith, Martin},\n  title = {Crop Evapotranspiration: Guidelines for Computing Crop Water Requirements},\n  series = {FAO Irrigation and Drainage Paper 56},\n  publisher = {FAO},\n  address = {Rome},\n  year = {1998}\n}\n\n@article{hargreaves1985,\n  author = {Hargreaves, George H. and Samani, Zohrab A.},\n  title = {Reference Crop Evapotranspiration from Temperature},\n  journal = {Applied Engineering in Agriculture},\n  volume = {1},\n  number = {2},\n  pages = {96--99},\n  year = {1985}\n}\n\n@article{goap2018,\n  author = {Goap, Amarendra and Sharma, Deepak and Shukla, A. K. and Krishna, C. Rama},\n  title = {An IoT Based Smart Irrigation Management System Using Machine Learning and Open Source Technologies},\n  journal = {Computers and Electronics in Agriculture},\n  volume = {155},\n  pages = {41--49},\n  year = {2018},\n  doi = {10.1016/j.compag.2018.09.040}\n}\n\n@article{augustin2016,\n  author = {Augustin, Aloÿs and Yi, Jiazi and Clausen, Thomas and Townsley, William Mark},\n  title = {A Study of LoRa: Long Range \\& Low Power Networks for the Internet of Things},\n  journal = {Sensors},\n  volume = {16},\n  number = {9},\n  pages = {1466},\n  year = {2016},\n  doi = {10.3390/s16091466}\n}\n",
  "doc": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "sec-motivation",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "الدافع"
          }
        ]
      },
      {
        "type": "slide",
        "attrs": {
          "id": null,
          "plain": false
        },
        "content": [
          {
            "type": "slideTitle",
            "content": [
              {
                "type": "text",
                "text": "لماذا الري الذكي؟"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "الزراعة تستهلك معظم المياه الجوفية في المملكة "
                      },
                      {
                        "type": "citation",
                        "attrs": {
                          "keys": [
                            "alahmadi2021"
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "المؤقتات الزمنية تروي حسب الجدول لا حسب الحاجة"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "الأنظمة التجارية "
                      },
                      {
                        "type": "text",
                        "text": "مكلفة",
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "text": " على المزارع الصغيرة"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "slidePause"
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "الهدف: الري عند حاجة التربة فقط، بتكلفة لا تتجاوز ٢٢٠ ريالًا للمنطقة."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "sec-system",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "النظام المقترح"
          }
        ]
      },
      {
        "type": "slide",
        "attrs": {
          "id": null,
          "plain": false
        },
        "content": [
          {
            "type": "slideTitle",
            "content": [
              {
                "type": "text",
                "text": "مكونات النظام"
              }
            ]
          },
          {
            "type": "columns",
            "content": [
              {
                "type": "column",
                "attrs": {
                  "widthPercent": 55
                },
                "content": [
                  {
                    "type": "figure",
                    "attrs": {
                      "src": "figures/irrigation-system.png",
                      "widthPercent": 100,
                      "id": "fig-system"
                    },
                    "content": [
                      {
                        "type": "caption",
                        "content": [
                          {
                            "type": "text",
                            "text": "من الحساسات إلى صمام الري"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "column",
                "attrs": {
                  "widthPercent": 45
                },
                "content": [
                  {
                    "type": "bulletList",
                    "content": [
                      {
                        "type": "listItem",
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "حساسات رطوبة على ثلاثة أعماق"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "listItem",
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "اتصال LoRa بمدى ٢ كم "
                              },
                              {
                                "type": "citation",
                                "attrs": {
                                  "keys": [
                                    "augustin2016"
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "listItem",
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "طاقة شمسية بالكامل"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "slideBox",
                    "attrs": {
                      "kind": "alert",
                      "title": "الفكرة الأساسية"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "القرار يُتخذ في المزرعة، والتقرير يصل إلى الهاتف."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "slide",
        "attrs": {
          "id": null,
          "plain": false
        },
        "content": [
          {
            "type": "slideTitle",
            "content": [
              {
                "type": "text",
                "text": "تقدير الاحتياج المائي"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "معادلة هارغريفز تكتفي بدرجات الحرارة "
              },
              {
                "type": "citation",
                "attrs": {
                  "keys": [
                    "hargreaves1985"
                  ]
                }
              },
              {
                "type": "text",
                "text": ":"
              }
            ]
          },
          {
            "type": "equation",
            "attrs": {
              "latex": "ET_o = 0.0023\\, R_a \\left(T_{mean} + 17.8\\right) \\sqrt{T_{max} - T_{min}}",
              "numbered": false,
              "id": null
            }
          },
          {
            "type": "slidePause"
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ثم تُحسب كمية الري اللازمة لإعادة التربة إلى السعة الحقلية:"
              }
            ]
          },
          {
            "type": "equation",
            "attrs": {
              "latex": "I = \\frac{\\left(\\theta_{fc} - \\theta\\right) D}{\\eta}",
              "numbered": false,
              "id": null
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": "sec-results",
          "numbered": true
        },
        "content": [
          {
            "type": "text",
            "text": "النتائج"
          }
        ]
      },
