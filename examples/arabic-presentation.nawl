  "metadata": {
    "title": "نظام ري ذكي منخفض التكلفة للمزارع الصغيرة",
    "subtitle": "نتائج التجربة الميدانية في منطقة القصيم",
    "short_title": "الري الذكي",
    "authors": [
      {
        "name": "عبدالله الأحمدي",
        "affiliations": [
          "قسم الهندسة الكهربائية، كلية الهندسة، جامعة الأفق، بريدة"
        ],
