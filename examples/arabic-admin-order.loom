  "templatePath": null,
  "metadata": {
    "organization": "جامعة المعرفة",
    "department": "إدارة الوثائق والمحفوظات",
    "title": "أمر إداري",
    "order_number": "٤٧/و/١٤٤٧",
    "date": "2026-02-03",
    "subject": "تشكيل لجنة لحصر الوثائق التاريخية وفهرستها",
    "attachments": "بيان بالوثائق (٣ صفحات)",
    "address": "جامعة المعرفة – ص.ب ١٢٣٤ الرياض ١١٤٥١ – هاتف ٠١١٢٣٤٥٦٧٨",
    "logo": "figures/logo-placeholder.png"
  },
  "bibliography": "\n",
  "doc": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "إنَّ مديرَ الجامعةِ، بناءً على الصلاحياتِ المخوَّلةِ له نظامًا، وإشارةً إلى خطابِ عميدِ شؤونِ المكتباتِ ذي الرقمِ ١٢٣٤ والمؤرَّخِ في ١٠/٧/١٤٤٧هـ بشأنِ الوثائقِ والمخطوطاتِ المحفوظةِ في مستودعِ المكتبةِ المركزية، ونظرًا لما تقتضيه المصلحةُ العامةُ من حفظِ هذا الإرثِ وإتاحتِه للباحثين،"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1,
          "id": null,
          "numbered": false
        },
        "content": [
          {
            "type": "text",
            "text": "يُقرِّرُ ما يأتي:"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "تُشكَّلُ لجنةٌ برئاسةِ الدكتورِ عبدِ اللهِ الأحمدي، وعضويةِ كلٍّ من الأستاذةِ سارةَ القحطاني والأستاذِ خالدٍ العمري، لحصرِ الوثائقِ التاريخيةِ والمخطوطاتِ وفهرستِها."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "تتولّى اللجنةُ المهامَّ الآتية:"
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "حصرَ الوثائقِ والمخطوطاتِ وتصنيفَها حسبَ تاريخِها وموضوعِها."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "إعدادَ فهرسٍ وصفيٍّ لكلِّ وثيقةٍ يتضمّنُ تاريخَها ومصدرَها وحالتَها."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "اقتراحَ ما يلزمُ لترميمِ الوثائقِ التالفةِ وحفظِها رقميًّا."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "تُنجزُ اللجنةُ أعمالَها خلالَ تسعين يومًا من تاريخِ هذا الأمر، وترفعُ تقريرَها النهائيَّ إلى مديرِ الجامعة."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "يُبلَّغُ هذا الأمرُ لمن يلزمُ لتنفيذِه، ويُعملُ به من تاريخِه."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "والله وليُّ التوفيق،،،"
          }
        ],
        "attrs": {
          "dir": null,
          "align": "center"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "مدير الجامعة",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ],
        "attrs": {
          "dir": null,
          "align": "left"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "أ.د. محمد بن سعد العتيبي"
          }
        ],
        "attrs": {
          "dir": null,
          "align": "left"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "صورة مع التحية إلى:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " عمادة شؤون المكتبات، إدارة الشؤون المالية، أعضاء اللجنة، الملف."
          }
        ]
      }
    ]
  }
}
