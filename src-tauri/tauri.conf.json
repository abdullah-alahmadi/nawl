{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Texloom",
  "version": "0.1.0",
  "identifier": "com.abdullah.texloom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Texloom",
        "width": 1400,
        "height": 900,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tectonic"
    ],
    "resources": {
      "tex-cache/": "tex-cache/",
      "fonts/": "fonts/"
    },
    "publisher": "Abdullah Al-Ahmadi",
    "copyright": "© 2026 Abdullah Al-Ahmadi",
    "category": "Productivity",
    "shortDescription": "Visual LaTeX editor with a no-code template designer",
    "longDescription": "Texloom is a visual (WYSIWYG) LaTeX editor in the spirit of LyX. Write reports, journal articles, theses and beamer presentations on a page that looks like the PDF, design templates without code, and compile with the bundled Tectonic or an installed TeX distribution.",
    "linux": {
      "deb": {
        "section": "tex"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
