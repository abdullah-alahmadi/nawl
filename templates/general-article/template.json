{
  "meta": {
    "version": "0.1.0",
    "id": "general-article",
    "name": "Article",
    "description": "One-column article or preprint: title block, abstract and keywords on the first page, numbered sections."
  },
  "page": {
    "paper": {
      "kind": "a4"
    },
    "margins": {
      "topMm": 25,
      "bottomMm": 25,
      "innerMm": 25,
      "outerMm": 25
    },
    "twoSided": false,
    "bindingOffsetMm": 0,
    "lineSpacing": {
      "kind": "single"
    },
    "paragraph": {
      "indentMm": 5,
      "spacingPt": 0
    }
  },
  "fonts": {
    "baseSizePt": 11,
    "main": {
      "kind": "builtin",
      "font": "termes"
    },
    "sans": {
      "kind": "builtin",
      "font": "heros"
    },
    "mono": {
      "kind": "builtin",
      "font": "latinModern"
    }
  },
  "structure": {
    "topLevel": "section",
    "numberedDepth": 3,
    "tocDepth": 2,
    "frontMatterPageNumbers": "arabic",
    "mainPageNumbers": "arabic",
    "perChapterNumbering": false,
    "appendixLabel": "Appendix {n}"
  },
  "headings": {
    "levels": [
      {
        "text": {
          "sizePt": 13,
          "bold": true,
          "italic": false,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 16,
        "spaceAfterPt": 6
      },
      {
        "text": {
          "sizePt": 11.5,
          "bold": true,
          "italic": false,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 12,
        "spaceAfterPt": 4
      },
      {
        "text": {
          "sizePt": 11,
          "bold": true,
          "italic": true,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 10,
        "spaceAfterPt": 4
      },
      {
        "text": {
          "sizePt": 11,
          "bold": false,
          "italic": true,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 8,
        "spaceAfterPt": 3
      }
    ]
  },
  "headerFooter": {
    "frontMatter": {
      "footer": {
        "center": "{page}"
      }
    },
    "main": {
      "footer": {
        "center": "{page}"
      }
    },
    "chapterOpening": {
      "footer": {
        "center": "{page}"
      }
    }
  },
  "captions": {
    "figureLabel": "Figure",
    "tableLabel": "Table",
    "separator": "colon",
    "labelBold": true,
    "size": "small",
    "align": "center"
  },
  "bibliography": {
    "style": "numeric",
    "title": "References",
    "inToc": false
  },
  "skeleton": [
    {
      "title": "Introduction",
      "required": true
    },
    {
      "title": "Related Work",
      "required": false
    },
    {
      "title": "Method",
      "required": true
    },
    {
      "title": "Results",
      "required": true
    },
    {
      "title": "Discussion",
      "required": false
    },
    {
      "title": "Conclusion",
      "required": true
    }
  ],
  "titlePage": {
    "items": [
      {
        "xMm": 105,
        "yMm": 25,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{title}",
          "style": {
            "sizePt": 18,
            "bold": true,
            "italic": false,
            "align": "center"
          },
          "widthMm": 160
        }
      },
      {
        "xMm": 105,
        "yMm": 38,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{authors}",
          "style": {
            "sizePt": 12,
            "bold": false,
            "italic": false,
            "align": "center"
          },
          "widthMm": 160
        }
      },
      {
        "xMm": 105,
        "yMm": 45,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{affiliation}",
          "style": {
            "sizePt": 10,
            "bold": false,
            "italic": true,
            "align": "center"
          },
          "widthMm": 160
        }
      },
      {
        "xMm": 105,
        "yMm": 50.5,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{email}",
          "style": {
            "sizePt": 9.5,
            "bold": false,
            "italic": false,
            "align": "center"
          },
          "widthMm": 160
        }
      }
    ],
    "blockHeightMm": 57
  },
  "fields": [
    {
      "id": "title",
      "label": "Title",
      "kind": "text",
      "required": true
    },
    {
      "id": "authors",
      "label": "Authors",
      "kind": "list",
      "required": true
    },
    {
      "id": "affiliation",
      "label": "Affiliation",
      "kind": "text"
    },
    {
      "id": "email",
      "label": "Contact e-mail",
      "kind": "text"
    },
    {
      "id": "abstract",
      "label": "Abstract",
      "kind": "paragraphs",
      "required": true
    },
    {
      "id": "keywords",
      "label": "Keywords",
      "kind": "paragraphs"
    }
  ],
  "frontMatter": [
    {
      "type": "titlePage"
    },
    {
      "type": "fieldPage",
      "title": "Abstract",
      "field": "abstract",
      "inToc": false,
      "inline": true
    },
    {
      "type": "fieldPage",
      "title": "Keywords",
      "field": "keywords",
      "inToc": false,
      "inline": true
    }
  ]
}
