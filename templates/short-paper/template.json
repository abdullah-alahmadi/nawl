{
  "meta": {
    "version": "0.1.0",
    "id": "short-paper",
    "name": "Short Paper",
    "description": "Compact one-column paper for workshops, extended abstracts and letters: small title block, abstract, numbered references."
  },
  "page": {
    "paper": {
      "kind": "letter"
    },
    "margins": {
      "topMm": 25.4,
      "bottomMm": 25.4,
      "innerMm": 25.4,
      "outerMm": 25.4
    },
    "twoSided": false,
    "bindingOffsetMm": 0,
    "lineSpacing": {
      "kind": "single"
    },
    "paragraph": {
      "indentMm": 4,
      "spacingPt": 0
    }
  },
  "fonts": {
    "baseSizePt": 10,
    "main": {
      "kind": "builtin",
      "font": "latinModern"
    },
    "sans": {
      "kind": "builtin",
      "font": "latinModern"
    },
    "mono": {
      "kind": "builtin",
      "font": "latinModern"
    }
  },
  "structure": {
    "topLevel": "section",
    "numberedDepth": 3,
    "tocDepth": 2,
    "frontMatterPageNumbers": "arabic",
    "mainPageNumbers": "arabic",
    "perChapterNumbering": false,
    "appendixLabel": "Appendix {n}"
  },
  "headings": {
    "levels": [
      {
        "text": {
          "sizePt": 12,
          "bold": true,
          "italic": false,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 12,
        "spaceAfterPt": 4
      },
      {
        "text": {
          "sizePt": 10.5,
          "bold": true,
          "italic": false,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 9,
        "spaceAfterPt": 3
      },
      {
        "text": {
          "sizePt": 10,
          "bold": true,
          "italic": true,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 7,
        "spaceAfterPt": 2
      },
      {
        "text": {
          "sizePt": 10,
          "bold": false,
          "italic": true,
          "uppercase": false
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 8,
        "spaceBeforePt": 6,
        "spaceAfterPt": 2
      }
    ]
  },
  "headerFooter": {
    "frontMatter": {
      "footer": {
        "center": "{page}"
      }
    },
    "main": {
      "footer": {
        "center": "{page}"
      }
    },
    "chapterOpening": {
      "footer": {
        "center": "{page}"
      }
    }
  },
  "captions": {
    "figureLabel": "Figure",
    "tableLabel": "Table",
    "separator": "colon",
    "labelBold": true,
    "size": "small",
    "align": "center"
  },
  "bibliography": {
    "style": "ieee",
    "title": "References",
    "inToc": false
  },
  "skeleton": [
    {
      "title": "Introduction",
      "required": true
    },
    {
      "title": "Approach",
      "required": true
    },
    {
      "title": "Evaluation",
      "required": false
    },
    {
      "title": "Conclusion",
      "required": true
    }
  ],
  "titlePage": {
    "items": [
      {
        "xMm": 107.95,
        "yMm": 25.4,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{title}",
          "style": {
            "sizePt": 15,
            "bold": true,
            "italic": false,
            "align": "center"
          },
          "widthMm": 165
        }
      },
      {
        "xMm": 107.95,
        "yMm": 35,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{authors}",
          "style": {
            "sizePt": 11,
            "bold": false,
            "italic": false,
            "align": "center"
          },
          "widthMm": 165
        }
      },
      {
        "xMm": 107.95,
        "yMm": 40.5,
        "anchor": "top",
        "content": {
          "type": "text",
          "text": "{affiliation}",
          "style": {
            "sizePt": 9.5,
            "bold": false,
            "italic": true,
            "align": "center"
          },
          "widthMm": 165
        }
      }
    ],
    "blockHeightMm": 50
  },
  "fields": [
    {
      "id": "title",
      "label": "Title",
      "kind": "text",
      "required": true
    },
    {
      "id": "authors",
      "label": "Authors",
      "kind": "list",
      "required": true
    },
    {
      "id": "affiliation",
      "label": "Affiliation",
      "kind": "text"
    },
    {
      "id": "abstract",
      "label": "Abstract",
      "kind": "paragraphs",
      "required": true
    }
  ],
  "frontMatter": [
    {
      "type": "titlePage"
    },
    {
      "type": "fieldPage",
      "title": "Abstract",
      "field": "abstract",
      "inToc": false,
      "inline": true
    }
  ]
}
