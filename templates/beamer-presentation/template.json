{
  "meta": {
    "id": "beamer-presentation",
    "name": "Presentation (Beamer)",
    "description": "Slides with LaTeX beamer: title slide, sections, columns, blocks and step-by-step reveals. Choose the theme, colours and 16:9 or 4:3 under Design.",
    "version": "1.0.0"
  },
  "kind": "presentation",
  "presentation": {
    "theme": "Madrid",
    "colorTheme": "",
    "fontTheme": "",
    "aspectRatio": "16:9",
    "fontSizePt": 11,
    "outline": false,
    "sectionSlides": false,
    "navigationSymbols": false
  },
  "page": {
    "paper": {
      "kind": "a4"
    },
    "margins": {
      "topMm": 25,
      "bottomMm": 25,
      "innerMm": 25,
      "outerMm": 25
    },
    "twoSided": false,
    "bindingOffsetMm": 0,
    "lineSpacing": {
      "kind": "single"
    },
    "paragraph": {
      "indentMm": 4,
      "spacingPt": 0
    }
  },
  "fonts": {
    "baseSizePt": 12,
    "main": {
      "kind": "builtin",
      "font": "latinModern"
    },
    "sans": {
      "kind": "builtin",
      "font": "heros"
    },
    "mono": {
      "kind": "builtin",
      "font": "latinModern"
    }
  },
  "structure": {
    "topLevel": "section",
    "numberedDepth": 3,
    "tocDepth": 2,
    "frontMatterPageNumbers": "arabic",
    "mainPageNumbers": "arabic",
    "perChapterNumbering": false,
    "appendixLabel": "Appendix {n}"
  },
  "headings": {
    "levels": [
      {
        "text": {
          "sizePt": 14,
          "bold": true,
          "italic": false,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 10,
        "spaceBeforePt": 14,
        "spaceAfterPt": 6
      },
      {
        "text": {
          "sizePt": 12,
          "bold": true,
          "italic": false,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 10,
        "spaceBeforePt": 10,
        "spaceAfterPt": 4
      },
      {
        "text": {
          "sizePt": 12,
          "bold": true,
          "italic": true,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 10,
        "spaceBeforePt": 8,
        "spaceAfterPt": 3
      },
      {
        "text": {
          "sizePt": 12,
          "bold": false,
          "italic": true,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 10,
        "spaceBeforePt": 6,
        "spaceAfterPt": 3
      }
    ]
  },
  "headerFooter": {
    "frontMatter": {
      "header": {
        "left": "",
        "center": "",
        "right": ""
      },
      "footer": {
        "left": "",
        "center": "",
        "right": ""
      },
      "headerRulePt": 0,
      "footerRulePt": 0
    },
    "main": {
      "header": {
        "left": "",
        "center": "",
        "right": ""
      },
      "footer": {
        "left": "",
        "center": "",
        "right": ""
      },
      "headerRulePt": 0,
      "footerRulePt": 0
    },
    "chapterOpening": {
      "header": {
        "left": "",
        "center": "",
        "right": ""
      },
      "footer": {
        "left": "",
        "center": "",
        "right": ""
      },
      "headerRulePt": 0,
      "footerRulePt": 0
    }
  },
  "captions": {
    "figureLabel": "Figure",
    "tableLabel": "Table",
    "separator": "colon",
    "labelBold": true,
    "size": "footnote",
    "align": "center"
  },
  "bibliography": {
    "style": "ieee",
    "title": "References",
    "inToc": false
  },
  "skeleton": [],
  "titlePage": {
    "items": []
  },
  "fields": [
    {
      "id": "title",
      "label": "Title",
      "kind": "text",
      "required": true
    },
    {
      "id": "subtitle",
      "label": "Subtitle",
      "kind": "text",
      "required": false
    },
    {
      "id": "authors",
      "label": "Presenters",
      "kind": "authors",
      "required": false
    },
    {
      "id": "institute",
      "label": "Institution (instead of the presenters' affiliations)",
      "kind": "text",
      "required": false
    },
    {
      "id": "date",
      "label": "Date or event (empty for today)",
      "kind": "text",
      "required": false
    }
  ],
  "frontMatter": []
}
