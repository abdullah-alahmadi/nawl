{
  "meta": {
    "id": "aps-physical-review",
    "name": "APS Physical Review",
    "description": "American Physical Society article (Physical Review A\u2013E style) using the official REVTeX 4.2 class. Change the options to prl for Physical Review Letters.",
    "version": "1.0.0"
  },
  "base": {
    "class": "revtex4-2",
    "options": [
      "aps",
      "pra",
      "twocolumn"
    ],
    "frontMatter": "revtex",
    "bibStyle": "apsrev4-2",
    "files": []
  },
  "page": {
    "paper": {
      "kind": "letter"
    },
    "margins": {
      "topMm": 19,
      "bottomMm": 25,
      "innerMm": 18,
      "outerMm": 18
    },
    "twoSided": false,
    "bindingOffsetMm": 0,
    "lineSpacing": {
      "kind": "single"
    },
    "paragraph": {
      "indentMm": 4,
      "spacingPt": 0
    }
  },
  "fonts": {
    "baseSizePt": 10,
    "main": {
      "kind": "builtin",
      "font": "latinModern"
    },
    "sans": {
      "kind": "builtin",
      "font": "heros"
    },
    "mono": {
      "kind": "builtin",
      "font": "latinModern"
    }
  },
  "structure": {
    "topLevel": "section",
    "numberedDepth": 3,
    "tocDepth": 2,
    "frontMatterPageNumbers": "arabic",
    "mainPageNumbers": "arabic",
    "perChapterNumbering": false,
    "appendixLabel": "Appendix {n}"
  },
  "headings": {
    "levels": [
      {
        "text": {
          "sizePt": 10,
          "bold": true,
          "italic": false,
          "smallCaps": false,
          "uppercase": true,
          "align": "center"
        },
        "layout": "inline",
        "label": "{n}.",
        "labelGapPt": 6,
        "spaceBeforePt": 12,
        "spaceAfterPt": 6
      },
      {
        "text": {
          "sizePt": 10,
          "bold": true,
          "italic": false,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}.",
        "labelGapPt": 6,
        "spaceBeforePt": 8,
        "spaceAfterPt": 4
      },
      {
        "text": {
          "sizePt": 10,
          "bold": false,
          "italic": true,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}.",
        "labelGapPt": 6,
        "spaceBeforePt": 6,
        "spaceAfterPt": 3
      },
      {
        "text": {
          "sizePt": 10,
          "bold": false,
          "italic": true,
          "smallCaps": false,
          "uppercase": false,
          "align": "left"
        },
        "layout": "inline",
        "label": "{n}",
        "labelGapPt": 6,
        "spaceBeforePt": 6,
        "spaceAfterPt": 3
      }
    ]
  },
  "headerFooter": {
    "frontMatter": {
      "header": {
        "left": "",
        "center": "",
        "right": ""
      },
      "footer": {
        "left": "",
        "center": "",
        "right": ""
      },
      "headerRulePt": 0,
      "footerRulePt": 0
    },
    "main": {
      "header": {
        "left": "",
        "center": "",
        "right": ""
      },
      "footer": {
        "left": "",
        "center": "",
        "right": ""
      },
      "headerRulePt": 0,
      "footerRulePt": 0
    },
    "chapterOpening": {
      "header": {
        "left": "",
        "center": "",
        "right": ""
      },
      "footer": {
        "left": "",
        "center": "",
        "right": ""
      },
      "headerRulePt": 0,
      "footerRulePt": 0
    }
  },
  "captions": {
    "figureLabel": "Figure",
    "tableLabel": "Table",
    "separator": "colon",
    "labelBold": true,
    "size": "footnote",
    "align": "center"
  },
  "bibliography": {
    "style": "ieee",
    "title": "References",
    "inToc": false
  },
  "skeleton": [
    {
      "title": "Introduction",
      "required": true
    },
    {
      "title": "Theory",
      "required": false
    },
    {
      "title": "Methods",
      "required": true
    },
    {
      "title": "Results",
      "required": true
    },
    {
      "title": "Conclusion",
      "required": true
    }
  ],
  "titlePage": {
    "items": []
  },
  "fields": [
    {
      "id": "title",
      "label": "Title",
      "kind": "text",
      "required": true
    },
    {
      "id": "authors",
      "label": "Authors (Name | Affiliation | Email)",
      "kind": "list",
      "required": true
    },
    {
      "id": "abstract",
      "label": "Abstract",
      "kind": "paragraphs",
      "required": true
    },
    {
      "id": "keywords",
      "label": "Keywords (comma-separated)",
      "kind": "text",
      "required": false
    }
  ],
  "frontMatter": []
}
