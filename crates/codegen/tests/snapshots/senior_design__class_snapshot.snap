%   \texloomfield{course}{...}   % Course
%   \texloomfield{team}{...}   % Team members
%   \texloomfield{advisor}{...}   % Advisor
%   \texloomfield{date}{...}   % Date
%   \texloomfield{abstract}{...}   % Abstract
%   \texloomfield{acknowledgements}{...}   % Acknowledgements
%   \begin{document}
%   \texloomfrontmatter
%   \texloommainmatter
%   ...
%   \end{document}
% List fields separate entries with \texloomsep.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{senior-design}

\LoadClass[12pt,oneside,openany]{report}

% Page
\RequirePackage[a4paper,top=25mm,bottom=25mm,inner=35mm,outer=25mm,bindingoffset=0mm,headheight=15pt]{geometry}
\RequirePackage{setspace}
\onehalfspacing
\frenchspacing
\setlength{\parindent}{0mm}
\setlength{\parskip}{6pt plus 1pt}

% Fonts
\RequirePackage{fontspec}
\setmainfont{texgyretermes}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]
\setsansfont{texgyreheros}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]

% Content
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage[normalem]{ulem}
\RequirePackage{enumitem}
\RequirePackage{lastpage}
\RequirePackage{tabularx}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\renewcommand\arraystretch{1.3}

% Captions
\RequirePackage{caption}
\captionsetup{labelfont=bf,labelsep=colon,font=small,justification=centering}
\captionsetup[table]{position=top}
\renewcommand\figurename{Figure}
\renewcommand\tablename{Table}

% Numbering
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% Headings
\RequirePackage{titlesec}
\titleformat{\chapter}[display]{\normalfont\fontsize{18}{21.6}\selectfont\bfseries\filcenter}{\MakeUppercase{Chapter \thechapter}}{8pt}{\MakeUppercase}
\titleformat{name=\chapter,numberless}[block]{\normalfont\fontsize{18}{21.6}\selectfont\bfseries\filcenter}{}{0pt}{\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{24pt}
\titleformat{\section}[hang]{\normalfont\fontsize{14}{16.8}\selectfont\bfseries\filright}{\thesection}{10pt}{}
\titleformat{name=\section,numberless}[block]{\normalfont\fontsize{14}{16.8}\selectfont\bfseries\filright}{}{0pt}{}
\titlespacing*{\section}{0pt}{18pt}{8pt}
\titleformat{\subsection}[hang]{\normalfont\fontsize{12}{14.4}\selectfont\bfseries\filright}{\thesubsection}{10pt}{}
\titleformat{name=\subsection,numberless}[block]{\normalfont\fontsize{12}{14.4}\selectfont\bfseries\filright}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{14pt}{6pt}
\titleformat{\subsubsection}[hang]{\normalfont\fontsize{12}{14.4}\selectfont\bfseries\itshape\filright}{\thesubsubsection}{10pt}{}
\titleformat{name=\subsubsection,numberless}[block]{\normalfont\fontsize{12}{14.4}\selectfont\bfseries\itshape\filright}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{12pt}{4pt}

% Metadata fields
\newcommand\texloomfield[2]{\expandafter\def\csname tl@f@#1\endcsname{#2}}
\newcommand\tl@f[1]{\ifcsname tl@f@#1\endcsname\csname tl@f@#1\endcsname\fi}
\newcommand\tl@ifnonempty[2]{\ifcsname tl@f@#1\endcsname#2\fi}
\newcommand\texloomsep{, }

% Headers and footers
\RequirePackage{fancyhdr}
% {chapter} and {section} placeholders show the plain titles.
\newcommand\tl@marks{\renewcommand\chaptermark[1]{\markboth{##1}{}}\renewcommand\sectionmark[1]{\markright{##1}}}
\fancypagestyle{texloomfront}{\fancyhf{}\fancyfoot[C]{\thepage{}}\renewcommand\headrulewidth{0pt}\renewcommand\footrulewidth{0pt}}
\fancypagestyle{texloommain}{\fancyhf{}\fancyhead[L]{\leftmark{}}\fancyhead[R]{\tl@f{course}}\fancyfoot[C]{Page \thepage{} of \pageref*{LastPage}}\renewcommand\headrulewidth{0.4pt}\renewcommand\footrulewidth{0pt}}
\fancypagestyle{texloomchapter}{\fancyhf{}\fancyfoot[C]{Page \thepage{} of \pageref*{LastPage}}\renewcommand\headrulewidth{0pt}\renewcommand\footrulewidth{0pt}}
\let\ps@plain\ps@texloomchapter

% Title page
\newcommand\tl@titlepage{%
  \begin{titlepage}%
  \renewcommand\texloomsep{\\}%
  \hyphenpenalty=10000\exhyphenpenalty=10000%
  \begin{tikzpicture}[remember picture,overlay]%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{18}{21.6}\selectfont\bfseries}] at ([xshift=105mm,yshift=-35mm]current page.north west) {\MakeUppercase{\tl@f{university}}};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{14}{16.8}\selectfont}] at ([xshift=105mm,yshift=-47mm]current page.north west) {\tl@f{department}};%
  \draw[line width=0.8pt] ([xshift=45mm,yshift=-62mm]current page.north west) -- ++(120mm,0);%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{13}{15.6}\selectfont\itshape}] at ([xshift=105mm,yshift=-75mm]current page.north west) {\tl@f{course}};%
  \node[anchor=north,inner sep=0pt,align=center,text width=160mm,font={\fontsize{24}{28.8}\selectfont\bfseries}] at ([xshift=105mm,yshift=-100mm]current page.north west) {\tl@f{title}};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{14}{16.8}\selectfont\scshape}] at ([xshift=105mm,yshift=-140mm]current page.north west) {Final Report};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{12}{14.4}\selectfont\itshape}] at ([xshift=105mm,yshift=-170mm]current page.north west) {Submitted by};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{14}{16.8}\selectfont}] at ([xshift=105mm,yshift=-179mm]current page.north west) {\tl@f{team}};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{12}{14.4}\selectfont\itshape}] at ([xshift=105mm,yshift=-228mm]current page.north west) {Advisor};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{14}{16.8}\selectfont}] at ([xshift=105mm,yshift=-237mm]current page.north west) {\tl@f{advisor}};%
  \node[anchor=north,inner sep=0pt,align=center,text width=170mm,font={\fontsize{13}{15.6}\selectfont}] at ([xshift=105mm,yshift=-265mm]current page.north west) {\tl@f{date}};%
  \end{tikzpicture}%
  \end{titlepage}}

% Front matter: everything before the main text, in template order
\newcommand\texloomfrontmatter{%
  \pagenumbering{roman}\let\ps@plain\ps@texloomfront\pagestyle{texloomfront}\tl@marks
  \tl@titlepage
  \tl@ifnonempty{abstract}{\chapter*{Abstract}\phantomsection\addcontentsline{toc}{chapter}{Abstract}\tl@f{abstract}\par}%
  \tl@ifnonempty{acknowledgements}{\chapter*{Acknowledgements}\phantomsection\addcontentsline{toc}{chapter}{Acknowledgements}\tl@f{acknowledgements}\par}%
  \renewcommand\contentsname{Table of Contents}\tableofcontents
  \renewcommand\listfigurename{List of Figures}\listoffigures
  \renewcommand\listtablename{List of Tables}\listoftables
}
\newcommand\texloommainmatter{%
  \clearpage\pagenumbering{arabic}\let\ps@plain\ps@texloomchapter\pagestyle{texloommain}\tl@marks}
\AtBeginDocument{\pagestyle{texloommain}\tl@marks}

% Bibliography: refs.bib next to the document
\newcommand\texloombibliography{\clearpage\phantomsection\addcontentsline{toc}{chapter}{References}\renewcommand\bibname{References}\bibliographystyle{IEEEtran}\bibliography{refs}}

% Appendices
\newcommand\texloomappendix{\clearpage\appendix\titleformat{\chapter}[display]{\normalfont\fontsize{18}{21.6}\selectfont\bfseries\filcenter}{\MakeUppercase{Appendix \thechapter}}{8pt}{\MakeUppercase}
\titleformat{name=\chapter,numberless}[block]{\normalfont\fontsize{18}{21.6}\selectfont\bfseries\filcenter}{}{0pt}{\MakeUppercase}}

